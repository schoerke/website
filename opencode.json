{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/patterns/react-components.md", "docs/patterns/data-fetching.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "turso db destroy *": "deny",
      "turso db import *": "ask",
      "turso db tokens create *": "deny",
      "turso db shell ksschoerke-production*": "ask",
      "turso db shell ksschoerke-development*": "allow",
      "turso db export ksschoerke-production*": "allow",
      "*payload migrate*": "ask",
      "*payload migrate:down*": "ask",
      "*payload migrate:reset*": "ask",
      "*payload migrate:fresh*": "ask",
      "*payload run *": "ask",
      "*tsx scripts/db/*": "ask",
      "*tsx scripts/*.ts": "ask",
      "git push --force*": "deny",
      "git push *": "ask",
      "git commit *": "ask",
      "git merge *": "ask",
      "git rm *": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    }
  }
}
