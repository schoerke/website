{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/patterns/react-components.md",
    "docs/patterns/data-fetching.md",
    "docs/patterns/payload.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "turso *": "ask",
      "turso db destroy *": "deny",
      "turso db tokens create *": "deny",
      "*payload migrate*": "ask",
      "*payload migrate:down*": "ask",
      "*payload migrate:reset*": "ask",
      "*payload migrate:fresh*": "ask",
      "*payload run *": "ask",
      "*tsx scripts/db/*": "ask",
      "*tsx scripts/*.ts": "ask",
      "git push *": "ask",
      "git push --force*": "deny",
      "git commit *": "ask",
      "git merge *": "ask",
      "git rm *": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    }
  }
}
