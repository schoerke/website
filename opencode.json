{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/patterns/react-components.md", "docs/patterns/data-fetching.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "turso db destroy *": "deny",
      "turso db import *": "ask",
      "turso db tokens create *": "deny",
      "git push *": "ask",
      "git push --force*": "deny",
      "git commit *": "ask",
      "git merge *": "ask",
      "git rm *": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny"
    }
  }
}
