{
  "name": "ksschoerke",
  "version": "1.0.0",
  "description": "The website for Künstlersekretariat Schoerke, built with Payload CMS and Next.js.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .git-hooks",
    "build": "pnpm generate:search-index && cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
    "build:ci": "pnpm migrate && pnpm build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "oxfmt --write .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:media": "tsx scripts/utils/regenerateMediaSizes.ts",
    "generate:search-index": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/reindexSearch.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "oxlint --config oxlint.config.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "build:posts-dataset": "tsx scripts/wordpress/buildPostsDataset.ts",
    "migrate:artists": "payload run scripts/wordpress/migrateArtists.ts",
    "migrate:employees": "payload run scripts/wordpress/migrateEmployees.ts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:media": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/wordpress/migrateMedia.js",
    "migrate:discography": "tsx scripts/migrateDiscographyToRecordings.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dump": "tsx scripts/db/dumpCollection.ts",
    "dump:artists": "pnpm dump artists",
    "dump:employees": "pnpm dump employees",
    "dump:recordings": "pnpm dump recordings"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@libsql/client": "^0.17.4",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/payload-cloud": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "graphql": "^16.14.2",
    "kbar": "1.0.0",
    "libsql": "^0.5.29",
    "lodash": "^4.18.1",
    "lucide-react": "1.39.0",
    "mime": "^4.1.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.12.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0"
}
